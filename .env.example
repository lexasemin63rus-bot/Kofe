# Токен бота, полученный от @BotFather
BOT_TOKEN=

# Chat ID, куда будут приходить уведомления о новых заказах
# (ваш личный chat_id, узнать можно у @userinfobot, либо chat_id группы/канала)
ADMIN_CHAT_ID=

# Публичный HTTPS-адрес, на котором открыт /public (нужен для кнопки WebApp в боте)
# Например, при разработке через ngrok: https://xxxxx.ngrok-free.app
MINI_APP_URL=

# Порт, на котором стартует express-сервер
PORT=3000
